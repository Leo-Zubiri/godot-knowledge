# --- Obsidian ---
# The vault config folder is per-user and may hold secrets (e.g. the Local REST API
# key in plugin data.json). Keep churn and secrets out of Git.
.obsidian/workspace.json
.obsidian/workspace*.json
.obsidian/cache
.obsidian/plugins/*/data.json
# Personal Obsidian preferences and optional community plugins (not shared)
.obsidian/app.json
.obsidian/appearance.json
.obsidian/graph.json
.obsidian/community-plugins.json
.obsidian/plugins/
.trash/
# If you prefer not to share ANY Obsidian config across clones, ignore the whole folder:
# .obsidian/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*~
*.swp
.idea/
.vscode/

# --- Secrets / local MCP config (keep out of Git) ---
# Live MCP client config and env file may reference/hold credentials.
# Only the *.example files are tracked; copy them locally when opting in.
.mcp.json
.env

# --- Scratch ---
*.tmp
.tmp/

# Local Claude Code settings (may hold secrets like MCP keys) — never commit
.claude/settings.local.json
